{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1920x1080",
    "VNC_DPI": "96"
  },
  "updateContentCommand": "bash .devcontainer/update_content.sh",
  "postCreateCommand": "printf 'AZURE_TENANT_ID=3aa4a235-b6e2-48d5-9195-7fcf05b459b0\\nAZURE_CLIENT_ID=6e4f6e15-5b73-40e7-835e-f563fabd604a\\n' > .env",
  "waitFor": "updateContentCommand",
  "forwardPorts": [6080],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Default Dark+"
      }
    }
  },
  "portsAttributes": {
    "8080": {
      "label": "Development server"
    },
    "6080": {
      "label": "noVNC desktop"
    }
  }
}
